# ClawVoice — Environment Variables
# Copy this file to .env and fill in your keys
#   cp .env.example .env

# ── Volcengine (火山引擎) ──────────────────────────────
# Speech recognition (ASR) + Speech synthesis (TTS)
# Get from: https://console.volcengine.com/speech
VOLC_APPID=your_app_id_here
VOLC_TOKEN=your_access_token_here
VOLC_SECRET=your_secret_key_here

# ── TTS Settings (optional) ─────────────────────────────
# TTS_RESOURCE_ID=seed-tts-2.0
# TTS_VOICE=zh_female_vv_uranus_bigtts

# ── OpenClaw Gateway (optional, for openclaw backend) ──
# OPENCLAW_HOST=192.168.1.x
# OPENCLAW_PORT=18789
# OPENCLAW_TOKEN=your_gateway_token

# ── LLM Backend ─────────────────────────────────────────
# "hermes" (default) or "openclaw"
# LLM_BACKEND=hermes
